#!/bin/sh
# Repository-local pre-commit hook. Install it with
#   ln -s ../../tools/hooks/pre-commit .git/hooks/pre-commit
#
# Refuses a commit whose files are not all on the tracked-path allow list
# (tools/check_tracked_paths.rb), judged by the allow list staged in the same
# commit. The pre-push hook checks every commit again before it leaves, so
# this one is about catching the mistake while it is still easy to undo.
#
# Bypass: git commit --no-verify

root=$(git rev-parse --show-toplevel)
checker="$root/tools/check_tracked_paths.rb"
if [ ! -f "$checker" ]; then
  echo "[pre-commit] $checker is missing; refusing to commit unchecked" >&2
  exit 1
fi
if ! out=$(ruby "$checker"); then
  printf '%s\n' "$out" >&2
  exit 1
fi
